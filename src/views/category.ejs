<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <link rel="stylesheet" href="../styles.css">
    <script src="https://kit.fontawesome.com/5c30b5e5d4.js" crossorigin="anonymous"></script>
</head>
<body>
    <%- include("partials/navBar") %>
    <h2 id="category-title">All products for <%= name.category_name %></h2>
    <div id="category-container">
        <% for (  product in category ) { %>
            <div class="category-item">
                <div class="category-item-image"><i class="fa-regular fa-image"></i></div>
                <div class="category-item-name"><%= category[product].product_name %></div>
                <div class="category-item-link"><a class="link-text" href="/products/<%= category[product].product_id %>">View</a></div>
            </div>
        <% } %>
    </div>
</body>
</html>
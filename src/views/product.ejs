<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.product_name %></title>
    <link rel="stylesheet" href="../styles.css">
    <script src="https://kit.fontawesome.com/5c30b5e5d4.js" crossorigin="anonymous"></script>
</head>
<body>
    <%- include("partials/navBar") %>
    <div id="product-container">
        <div id="product-item">
            <div id="product-image"><i class="fa-regular fa-image"></i></div>
            <div id="product-name"><%= product.product_name %></div>
            <div id="product-price">£<%= product.product_price %></div>
            <div id="product-quantity">quantity:<%= product.product_quantity %></div>
            <form id="product-delete-form" action="/products/<%= product.product_id %>/delete" method="POST"
                onsubmit="return confirm('Delete this product? This cannot be undone.');">
                <button id="product-delete" type="submit">Delete</button>
            </form>
        </div>
    </div>
</body>
</html>
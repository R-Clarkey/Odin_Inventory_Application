<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Items</title>
    <link rel="stylesheet" href="styles.css">
    <script src="https://kit.fontawesome.com/5c30b5e5d4.js" crossorigin="anonymous"></script>
</head>
<body>
    <%- include("partials/navBar") %>
    <h2>All Products</h2>
    <div id="products-container">
        <% for( let product in products ) { %>
            <% console.log(products[product]) %>
            <div class="products-product">
                <div class="products-product-image"><i class="fa-regular fa-image"></i></div>
                <div class="products-product-name"><%= products[product].product_name %></div>
                <div class="products-product-link"><a class="link-text" href="/products/<%= products[product].product_id %>">View</a></div>
            </div>
        <% } %>
    </div>
</body>
</html>